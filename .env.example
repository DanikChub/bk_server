# Compose example. For local Next.js development copy to frontend/.env.local
# and change postgres/rabbitmq hostnames to 127.0.0.1 and your local ports.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://consulting:replace-with-generated-password@postgres:5432/consulting_lk
POSTGRES_PASSWORD=replace-with-generated-password
RABBITMQ_PASSWORD=replace-with-generated-rabbit-password
RABBITMQ_URL=amqp://consulting:replace-with-generated-rabbit-password@rabbitmq:5672
RABBITMQ_EXCHANGE=
RABBITMQ_TENANT_CREATED_KEY=
RABBITMQ_TENANT_DELETED_KEY=
RABBITMQ_CONSUMER_QUEUE=
BUSINESS_TIMEZONE=Europe/Moscow
UPDATE_CUSTOMER_STATUS_CRON=0 0 * * *
TZ=Europe/Moscow
NEXT_PUBLIC_DATA_MODE=live

S3_ENDPOINT=https://s3.yandexcloud.net
S3_REGION=ru-central1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ATTACHMENTS_BUCKET=
S3_PUBLIC_BUCKET=
S3_STORIES_BUCKET=
S3_EMPLOYEE_AVATAR_BUCKET=

CONTENT_API_URL=
CONTENT_API_AUTHORIZATION=
BK_API_URL=https://bk.kv34.ru/api/v1/
BK_ARTICLE_KEY=
BK_NEWS_KEY=
WORK_CALENDAR_TOKEN=

EXTERNAL_API_KEY=
EXTERNAL_JWT_SECRET=
EXTERNAL_ALLOWED_ORIGINS=
EXTERNAL_LIBRARY_URL=

# Optional ABP encrypted-password compatibility. Match the original installation.
LEGACY_PASSWORD_ENCRYPTION_ENABLED=false
LEGACY_PASSWORD_ENCRYPTION_KEY=
LEGACY_ENCRYPTION_SALT_BASE64=
LEGACY_ENCRYPTION_IV_BASE64=

# Supply only for the one-time bootstrap command; existing accounts are not overwritten.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=
