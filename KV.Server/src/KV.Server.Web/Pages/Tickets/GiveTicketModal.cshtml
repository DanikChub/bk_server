@page
@using KV.Server.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model KV.Server.Web.Pages.Tickets.GiveTicketModalModel
@inject IStringLocalizer<ServerResource> L
@{
    Layout = null;
}

<form asp-page="/Tickets/GiveTicketModal">
    <abp-modal>
        <abp-modal-header title="@L["Ticket:GiveTicket"]"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="@Model.TicketId"/>
            <select class="form-control" asp-for="@Model.GiveTicket.CustomerUserProfileId" asp-items="@Model.Employees" label="@L["ContractStatus:Label:Item"]">
            </select>
        </abp-modal-body>
        <abp-modal-footer buttons="@AbpModalButtons.Save | AbpModalButtons.Cancel"></abp-modal-footer>
    </abp-modal>
</form>