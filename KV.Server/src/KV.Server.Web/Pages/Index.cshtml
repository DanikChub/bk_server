@page
@using KV.Server.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Configuration
@using Volo.Abp.Users
@using Volo.Abp.MultiTenancy
@model KV.Server.Web.Pages.IndexModel
@inject IHtmlLocalizer<ServerResource> L
@inject ICurrentUser CurrentUser
@inject ICurrentTenant CurrentTenant
@inject IPageLayout PageLayout
@inject IConfiguration Configuration
@{
    PageLayout.Content.Title = "Главная";
    string[] months = { "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь" };
}

@section styles {
    <abp-style src="/libs/zuck.js/dist/zuck.min.css"/>
    <abp-style src="/css/site.css"/>
    <abp-style src="/css/main.css"/>
    <abp-style src="/libs/keen-slider/keen-slider.min.css"/>
}

@section scripts {
    <abp-script src="/Pages/Index.js"/>
    <abp-script src="/libs/zuck.js/dist/zuck.js"/>
    <script type="text/javascript" src="/libs/@@appricot/custom-stories-component/dist/index.js"></script>
    <script src="/libs/keen-slider/keen-slider.js"></script>
    <abp-script src="/js/createStories.js"/>
    <abp-script src="/js/news.js"/>
}

<div class="main-page">
    <main class="main-page__content">
        <div id="slider1" class="keen-slider" style="position: relative;">
            <div class="arrow-button arrow-button_left" data-slider="slider1">
                <img src="/assets/mainPage/leftArrow.svg" data-slider="slider1">
            </div>
            <div class="arrow-button arrow-button_right" data-slider="slider1">
                <img src="/assets/mainPage/rightArrow.svg" data-slider="slider1">
            </div>
            <section class="change-slide" data-slider="slider1"></section>
        </div>
        <section class="main-page__apps">
            <div class="main-page__app">Калькуляторы</div>
            <div class="main-page__app">Классификаторы</div>
            <div class="main-page__app">Справки</div>
            <div class="main-page__app">
                <a href="/Calendar" style="color: inherit;">Мой календарь</a>
            </div>
        </section>
        <div class="main-page__wrapper">
            <section class="main-page__description">
                <h5>Главное:</h5>
                <ul data-labraby='@Configuration["BkOpenApiConfig:PublicBaseUrl"]' class="posts-container">
                </ul>
                <p>
                    <a style="color: rgb(103, 106, 108);" href="https://bk.kv34.ru/news" target="_blank">Читать все новости</a>
                </p>
            </section>
        </div>

    </main>
    <aside class="main-page__extra">
        <div id="slider2" class="keen-slider" style="position: relative">
            <div class="arrow-button arrow-button_left" data-slider="slider2">
                <img src="/assets/mainPage/leftArrow.svg" data-slider="slider2">
            </div>
            <div class="arrow-button arrow-button_right" data-slider="slider2">
                <img src="/assets/mainPage/rightArrow.svg" data-slider="slider2">
            </div>
            <section class="change-slide" data-slider="slider2"></section>
        </div>
        <div>
            <div class="main-page__library">
                <h4>Библиотека консультаций:</h4>
            </div>
        </div>
    </aside>
</div>