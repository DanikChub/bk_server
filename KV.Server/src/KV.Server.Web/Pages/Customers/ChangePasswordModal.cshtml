@page
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model KV.Server.Web.Pages.Customers.ChangePasswordModalModel
@{
    Layout = null;
}
<form asp-page="/Customers/ChangePasswordModal">
    <abp-modal size="Large">
        <abp-modal-header title="Смена пароля пользователя"></abp-modal-header>
        <abp-modal-body>
            <!--hidden input-->
            <abp-input asp-for="ChangePassword.UserId"></abp-input>
            <abp-input asp-for="@Model.ChangePassword.NewPassword" label="Новый пароль"></abp-input>
        </abp-modal-body>
        <abp-modal-footer>
            <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
        </abp-modal-footer>
    </abp-modal>
</form>