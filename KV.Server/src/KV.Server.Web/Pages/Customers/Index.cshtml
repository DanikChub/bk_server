@page
@using KV.Server.Localization
@using KV.Server.Web.Menus;
@using Microsoft.Extensions.Localization
@using KV.Server.Helpers
@using Volo.Abp.Users
@model Server.Web.Pages.Customers.IndexModel
@inject IStringLocalizer<ServerResource> L
@inject ICurrentUser CurrentUser;
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = L["Customers"];
    PageLayout.Content.MenuItemName = ServerMenuContributor.CUSTOMERS;
}

@section scripts
{
    <abp-script src="/js/renderTooltip.js" />
    <abp-script src="/js/createTableFunctions.js"></abp-script>
    <abp-script src="/js/createTable.js" />
    <abp-script src="/Pages/Customers/Index.js" />
    <abp-script src="/Pages/Customers/CreateContractModal.js" />
}

@section styles {
    <abp-style src="/css/bem.css" />
    <abp-style src="/css/table.css" />
    <abp-style src="/css/site.css" />
    <abp-style src="/css/common-table.css" />

    <style>
        .card {
            border-radius: 0;
        }
    </style>
}

@{
    var currentUri =
    $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}{HttpContext.Request.Path}{HttpContext.Request.QueryString}";
    var uri = new Uri(currentUri);
}

<abp-card style="border: 0">
    <abp-card-body>
        <h3 class="title title_position">Клиенты <span id="CustomerProfiles-Count"></span></h3>
        <form>
            <div style="display: flex; justify-content: space-between; padding-bottom: 1rem">
                <div style="display: flex; gap: 1rem">
                    <button type="button" class="open-in-excel btn" style="height: 100%;"
                        onclick="window.open('@(uri.CreateOrUpdateParameterValueUri("handler", "ExcelTable"))', '_self');">
                        Открыть в Excel
                    </button>
                    <a href="/Customers/CreateCustomer">
                        <button type="button" style="background-color: #1AB394;height: 100%;"
                            class="button button_text-white">
                            <img src="/img/buttons/addWhite.svg" class="button__icon"></img>
                            Новый клиент
                        </button>
                    </a>
                    <button type="button" style="background-color:  #1AB394;" data-responsible-id="@CurrentUser.Id"
                        class="button button_text-white" id="my-clients-button">
                        Мои клиенты
                    </button>
                </div>
                <div style="align-items: center; display: flex;">
                    <span style="margin-right: 12px;" id="filter_count"></span>
                    <button id="table-filter" type="button" style="margin-right: 1rem;" class="btn btn_white">
                        <img src="/img/buttons/filter.svg" alt="filters" width="16" height="16">
                    </button>
                    <input asp-for="Search.ResponsibleManagerId" />
                    <input asp-for="Search.SearchStr" placeholder="Поиск"
                        class="form-control input_bordered input_small" type="text" style="flex-basis: 95%" />
                    <button style="background-color: #1AB394;"
                        class="button_small button_small_green button_small_bordered" type="submit"
                        id="sub">Найти</button>
                </div>
            </div>
        </form>
        <abp-table striped-rows="true" id="CustomerProfiles"></abp-table>
    </abp-card-body>
</abp-card>
