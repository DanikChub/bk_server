<form asp-page="/Customers/CreateCustomerModal">
    <abp-modal size="Large">
        <abp-modal-header title="Новый клиент"></abp-modal-header>
        <abp-modal-body>
            <div class="row">
                <div class="col">
                    <abp-input asp-for="Customer.ShortName" id="shirt-name" label="Короткое Название"></abp-input>
                    <abp-input asp-for="Customer.INNNumber" id="inn" label="Номер ИНН"></abp-input>
                </div>
                <div class="col">
                    <abp-input asp-for="Customer.KPPNumber" id="kpp" label="Номер КПП"></abp-input>
                    <abp-input asp-for="Customer.SiteUrl" id="site" label="Ссылка Сайта"></abp-input>
                </div>
                <div class="col">
                    <abp-input asp-for="Customer.ContractEmail" id="email" label="Контактный Email"></abp-input>
                    <abp-input asp-for="Customer.ContractPhoneNumber" id="phone" label="Контактный Телефон"></abp-input>
                </div>
                <abp-input asp-for="Customer.LongName" id="long-name" label="Длинное Название"></abp-input>
                <abp-input asp-for="Customer.Address" id="adress" label="Адрес"></abp-input>
                <abp-input asp-for="Customer.DisplayName" label="Отображаемое имя"></abp-input>
                <abp-input asp-for="Customer.CommentNotes" label="Заметки"></abp-input>

                <abp-input asp-for="Customer.AdminEmailAddress" label="@L["TenantProfile:AdminEmailAddress"]"></abp-input>
                <abp-input asp-for="Customer.AdminPassword" label="@L["TenantProfile:AdminPassword"]"></abp-input>

                <label>Описание</label>
                <div class="mb-3">
                    <textarea asp-for="Customer.Description" class="form-control" style="height: 200px;"></textarea>
                </div>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>