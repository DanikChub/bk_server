@page
@using KV.Server.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model KV.Server.Web.Pages.Customers.CreateManagerModalModel
@inject IStringLocalizer<ServerResource> L
@{
    Layout = null;
}
<form asp-page="/Customers/CreateManagerModal">
    <abp-modal size="Large">
        <abp-modal-header title="Новый менджер"></abp-modal-header>
        <abp-modal-body>
            <!--hidden input-->
            <abp-input asp-for="CreateManager.TenantId"></abp-input>
            <abp-select asp-items="@Model.CustomersUserProfile" asp-for="CreateManager.CustomerUserProfileId" label="Менеджер"></abp-select>
        </abp-modal-body>
        <abp-modal-footer>
            <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
        </abp-modal-footer>
    </abp-modal>
</form>