@page "{id:Guid}"
@using Abp.AspNetCore.Mvc.UI.Theme.KvInternal.Themes.KvInternal.Components.BreadCrumb
@using KV.Server.Localization
@using KV.Server.Web.Menus;
@using Microsoft.Extensions.Localization
@model KV.Server.Web.Pages.Customers.EditContractModel
@inject IStringLocalizer<ServerResource> L
@inject IPageLayout PageLayout
@{
    PageLayout.Content.MenuItemName = ServerMenuContributor.CUSTOMERS;
    PageLayout.Content.BreadCrumb.Add("Клиенты", "/Customers");
    PageLayout.Content.BreadCrumb.Add($"{Model.Customer.DisplayName}", $"/Customers/Details/{Model.Customer.Id}");
    PageLayout.Content.BreadCrumb.Add($"Договоры", $"/Customers/Details/{Model.Customer.Id}#contractsTab");
    PageLayout.Content.BreadCrumb.Add($"{Model.EditContract.Name}");

    PageLayout.Content.BreadCrumb.ShowCurrent = false;

    var contactUserName = $"{Model.Customer.ContractOwner?.LastName ?? string.Empty} {Model.Customer.ContractOwner?.FirstName ?? string.Empty} {Model.Customer.ContractOwner?.MiddleName ?? string.Empty}";
}

@section styles {
    <abp-style src="/css/bem.css"></abp-style>
    <abp-style src="/css/customers.css"></abp-style>
}
@section scripts {
    <abp-script src="/Pages/Customers/EditContract.js" />
}

<style>
    .mb-3 {
        display: flex;
        align-items: center;
        gap: 23px;
        width: 100%;
        margin-bottom: 0 !important;
    }

    .customers__side-data {
        max-width: 400px;
        background-color: white;
    }

    .field__block {
        display: flex;
        align-items: center;
        gap: 23px;
        padding: 20px 0;
        border-top: 1px solid #DDE4E8;
    }

    .field__block label {
        min-width: 251px;
        font-family: Inter;
        font-size: 14px;
        font-weight: 600;
        line-height: 16.94px;
        text-align: right;
        color: #334557;
    }

    .restriction_control label {
        min-width: auto;
    }
</style>

<form method="post">
    <div style="display: flex; gap: 16px">
        <div class="content">
            <input asp-for="EditContract.Id" hidden />
            <input asp-for="EditContract.StatusId" hidden />
            <input asp-for="EditContract.TenantId" hidden />
            <h2 class="content__title">
                Обновление договора
            </h2>
            <div>
                <div class="field__block">
                    <label>Номер договора</label>
                    <input class="form-control" id="contractNumber" asp-for="EditContract.Name"></input>
                </div>
                <section class="field__block">
                    <label>Договор заключен на</label>
                    <input class="form-control" id="contractNumber" asp-for="EditContract.ContractPayer"></input>
                </section>
                <section class="field__block">
                    <abp-date-picker placeholder="Дата регистрации в ЛК" label="Дата регистрации в ЛК" style="width: calc(100% - 35.2px);"
                        asp-for="EditContract.CreationTime" />
                </section>
                <section class="field__block">
                    <abp-date-picker placeholder="Дата начала действия договора" label="Дата начала действия договора"
                        style="width: calc(100% - 35.2px);" asp-for="EditContract.ContractStartDate" />
                </section>
                <section class="field__block">
                    <abp-date-picker placeholder="Дата окончания действия договора" style="width: calc(100% - 35.2px);"
                        label="Дата окончания действия договора" asp-for="EditContract.ContractFinishDate" />
                </section>
                <section class="field__block">
                    <label class="label_small">Пакет услуг</label>
                    <section class="tags">
                        @foreach (var item in Model.ContractServicePackages)
                        {
                            <div class="tags__el" style="background-@item.Style">@item.Name
                                <button service-package-id="@item.Id" class="tags__delete"
                                    style="background-color: transparent; height:20px; width: 10px; background-image: url('/img/big-cross.svg'); background-repeat: no-repeat; background-position: center; border: none;"></button>

                            </div>
                        }

                        <button contract-id="@Model.EditContract.Id" id="add-package" class="button"
                            style="height: 24px">
                            <img class="button__icon" src="/img/buttons/addGray.svg"></img>
                        </button>
                    </section>
                    <!-- <select class="select" asp-for="EditContract.ServicePackageId" asp-items="@Model.ServicePackages"></select> -->
                </section>
                <section class="field__block">
                    <label class="label_small">Тэг</label>
                    <div class="tags">
                         @if (Model.Tags.Count() > 0)
                    {
                        @foreach (var item in Model.Tags)
                        {
                            <div class="tag">
                                @item.Name
                                <button tag-id="@item.Id" class="deleteTag"
                                    style="background-color: transparent; height:20px; width: 10px; background-image: url('/img/big-cross.svg'); background-repeat: no-repeat; background-position: center; border: none;">
                                </button>

                            </div>
                        }
                    }
                    else
                    {
                        <h4>Нет тегов</h4>
                    }

                        <button contract-id="@Model.EditContract.Id" id="add-tag" class="button" style="height: 24px">
                            <img class="button__icon" src="/img/buttons/addGray.svg"></img>
                            Добавить
                        </button>
                    </div>
                </section>
                <section class="field__block">
                    <label>Ограничения</label>
                     <div class="edit-restrictions" style="margin-bottom: 16px;">
                        <div class="restriction_control">
                            <label class="label_small edit-restrictions__label">НПА</label>
                            <input type="number" asp-for="EditContract.NPARange" class="form-control input_small"
                                style="width: 60px" />
                            <!-- <select asp-for="EditContract.NPARange" class="select select_small edit-restrictions__select" asp-items="@Model.StandartContractRangeNumbers"></select> -->
                        </div>
                        <div class="restriction_control">
                            <label class="label_small edit-restrictions__label">Закупки</label>
                            <input type="number" asp-for="EditContract.PurchaseRange" class="form-control input_small"
                                style="width: 60px" />
                            <!-- <select asp-for="EditContract.PurchaseRange" class="select select_small edit-restrictions__select" asp-items="@Model.StandartContractRangeNumbers"></select> -->
                        </div>
                        <div class="restriction_control">
                            <label class="label_small edit-restrictions__label">Торги</label>
                            <input type="number" asp-for="EditContract.TradingRange" class="form-control input_small"
                                style="width: 60px" />
                            <!-- <select asp-for="EditContract.TradingRange" class="select select_small edit-restrictions__select" asp-items="@Model.StandartContractRangeNumbers"></select> -->
                        </div>
                        <div class="restriction_control">
                            <label class="label_small edit-restrictions__label">Бухучет</label>
                            <input type="number" asp-for="EditContract.AccountingRange" class="form-control input_small"
                                style="width: 60px" />
                            <!-- <select asp-for="EditContract.AccountingRange" class="select select_small edit-restrictions__select" asp-items="@Model.StandartContractRangeNumbers"></select> -->
                        </div>
                        <div class="restriction_control">
                            <label class="label_small edit-restrictions__label">Претензия</label>
                            <input type="number" asp-for="EditContract.ClaimRange" class="form-control input_small"
                                style="width: 60px" />
                            <!-- <select asp-for="EditContract.ClaimRange" class="select select_small edit-restrictions__select" asp-items="@Model.StandartContractRangeNumbers"></select> -->
                        </div>
                    </div>
                </section>
            </div>
            
            <section class="content__buttons" style="margin-bottom: 0">
                <a class="button" href="/Contracts">
                    <img class="button__icon" src="/img/buttons/cancel.svg" />
                    Отмена
                </a>
                <button type="submit" class="button button_green" onclick="abp.notify.success('Договор обновлён!');">
                    <img class="button__icon" src="/img/buttons/documentWhite.svg"></img>
                    Обновить договор
                </button>
                
            </section>
        </div>

        <div class="customers__side-data">
            <h3>Информация об организации</h3>
            <div class="customers__side-data-wrapper">
                <button onclick="window.open('/Customers/UpdateCustomer/@Model.Customer.Id')"
                    class="open-reply-block-btn btn btn-sm btn-white">
                    <img src="/img/buttons/edit.svg" alt="edit">
                    Редактировать
                </button>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Название организации</div>
                    <div>
                        <a href="/Customers/Details/@Model.Customer.Id">
                            @Model.Customer.OrganizationName
                        </a>
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Статус</div>
                    <div>
                        <img src="/img/status-ok.png" alt="status-icon">
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Контактное лицо</div>
                    <div>
                        @contactUserName
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Дата создания</div>
                    <div>
                        @Model.Customer.CreationTime.ToString("dd.MM.yyyy HH:ss")
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Ответственный</div>
                    <div>
                        @if (!string.IsNullOrWhiteSpace(Model.Customer.ResponsibleManager))
                        {
                            @Model.Customer.ResponsibleManager
                            ;
                        }
                        else{
                            <span>Отсутствует</span>
                        }

                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">ИНН/КПП</div>
                    <div>
                        @{
                            var iNNAndKPPNumber = $"{Model.Customer.INNNumber}";
                            if (!(Model.Customer.INNNumber.IsNullOrWhiteSpace() ||
                            Model.Customer.KPPNumber.IsNullOrWhiteSpace()))
                            {
                                iNNAndKPPNumber += " / ";
                            }
                            iNNAndKPPNumber += Model.Customer.KPPNumber;
                        }
                        @iNNAndKPPNumber
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Адрес</div>
                    <div>
                        @Model.Customer.Address
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Web-сайт</div>
                    <div>
                        @Model.Customer.SiteUrl
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Эл. почта</div>
                    <div>
                        @(Model.Customer.ContractOwner?.Email ?? string.Empty)
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Примечание</div>
                    <div>
                        @Model.Customer.CommentNotes
                    </div>
                </div>
                <div class="customers__side-data-item">
                    <div class="customers__side-data-item-title">Пакеты услуг</div>
                    <div class="customers__side-data-item-description">
                        @foreach (var servicePackage in Model.ContractServicePackages)
                        {
                            <div class="side-data_blue" style="background-@servicePackage.Style">@servicePackage.Name
                                @*(@servicePackage.ContractName до @servicePackage.FinishDate.ToString("dd.MM.yyyy"))*@
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

</form>