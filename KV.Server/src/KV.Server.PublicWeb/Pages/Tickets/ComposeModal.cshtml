@page "/Tickets/Compose/ComposeModal"
@using Volo.Abp.MultiTenancy
@using KV.Server.Localization
@using Microsoft.Extensions.Localization
@model KV.Server.PublicWeb.Pages.Tickets.ComposeModalModel
@inject ICurrentTenant CurrentTenant
@inject IStringLocalizer<ServerResource> L
@{
    Layout = null;
}

@section styles {
    <abp-style src="/css/tickets.css"/>
}

<!-- Нужно распихать стили и js по отдельным файлам -->
<style>
    .profile-modal-page * { box-sizing: border-box; }

    .profile-modal-page {
        height: 100%;
        margin: 0;
        padding: 0;
        transition: background 0.15s linear;
        width: 100%;
    }

    .profile-modal_wrapper {
        background: #A7B1C2;
        max-width: 735px;
        padding: 8px;
        position: fixed;
        right: calc(50% - 735px / 2);
        top: 15%;
        transition: opacity 0.15s linear, height 0.10s linear;
        width: 100%;
    }

    .profile-modal__header {
        background: #A7B1C2;
        height: 100%;
        max-height: 33px;
    }

    .profile-modal__content {
        background: white;
        width: 100%;
    }

    .profile-modal__header-warning {
        display: flex;
        flex-shrink: 0;
        height: 32.131px;
        justify-content: center;
        width: 100%;
    }

    .profile-modal__header-text {
        color: #FFF;
        font-family: Open Sans;
        font-size: 16px;
        font-style: normal;
        font-weight: 700;
        line-height: 16px;
        text-align: center;
    }

    .profile-modal__header-bell {
        height: 16px;
        margin-right: 10px;
        width: 15px;
    }

    .profile-modal__header-close-container {
        display: flex;
        justify-content: end;
        width: 100%;
    }

    .profile-modal__clouse-button {
        cursor: pointer;
        height: 24px;
        width: 24px;
    }

    .profile-modal__content {
        background: url("/img/pen.png") no-repeat;
        background-position: 100%;
        background-size: 100%;
        height: 419px;
        width: 100%;
    }

    .profile-modal-page p {
        color: #334557;
        font-family: Open Sans;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 16px;
        text-align: center;
    }

    .profile-modal-page span { font-weight: 600; }

    .profile-modal__content-text {
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        height: 181.74px;
        justify-content: center;
        width: 100%;
    }

    .color-red { color: #ED5565; }

    .profile-modal__content-button {
        align-items: center;
        background: #1AB394;
        border: none;
        border-radius: 0px 3px 3px 0px;
        color: white;
        cursor: pointer;
        display: flex;
        flex-shrink: 0;
        font-weight: 600;
        height: 32.131px;
        justify-content: center;
        padding: 5px 10px 6px 10px;
        width: 312.141px;
    }

    .profile-modal__content-button-container {
        display: flex;
        height: 100%;
        justify-content: center;
        margin-top: 175px;
        width: 100%;
    }
</style>

<!-- Need to remove this button and subscribe to realy event -->
<div>
    <button type="button" onclick="showModal()">Show modal window</button>
</div>

<div class="profile-modal-page">
    <div class="profile-modal_wrapper">
        <div class="profile-modal__header">
            <div class="profile-modal__header-close-container">
                <img onclick="closeButton()" class="profile-modal__clouse-button" src="/img/cross.svg"/>
            </div>
            <div class="profile-modal__header-warning">
                <img class="profile-modal__header-bell" src="/img/bell.svg"/>
                <span class="profile-modal__header-text">ВНИМАНИЕ!</span>
            </div>
        </div>
        <div class="profile-modal__content">
            <div class="profile-modal__content-text">
                <p>
                    <span>Доступ в Личный Кабинет будет ограничен</span> <span class="color-red">через 7 дней</span> <br/>
                    в связи с истечением срока действия Лицензионного договора № 131/23.
                </p>
                <p>
                    Мы будем очень рады, если Вы вернетесь!
                </p>
            </div>
            <div class="profile-modal__content-button-container">
                <button onclick="sendApplication()" type="button" class="profile-modal__content-button">
                    Отправить заявку на продление договора
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const modal = document.querySelector(".profile-modal_wrapper");
    const background = document.querySelector(".profile-modal-page");

    modal.style.display = "none";
    modal.style.opacity = "0";
    modal.style.height = "0";

    background.style.background = "none";

    const closeButton = () => {
        modal.style.height = "0px";
        background.style.background = "none";

        setTimeout(() => {
            modal.style.display = "none";
            modal.style.opacity = "0";
        }, 150);
    };

    const showModal = () => {
        modal.style.display = "block";
        background.style.background = "#79797A";

        setTimeout(() => {
            modal.style.opacity = "1";
            modal.style.height = "468px";
        }, 150);
    };

    const sendApplication = () => {
        //your logic
        alert("you need to add logic")
    };
</script>