@page
@using KV.Server.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model KV.Server.PublicWeb.Pages.Tickets.RatingSuccessModalModel
@inject IStringLocalizer<ServerResource> L
@{
    Layout = null;
}

<style>
    .modal-header button.btn-close {
        margin: 0;
        align-self: start;
        padding: 0;
        width: 0.75rem;
        height: 0.75rem;
    }

    .modal__title {
        color: var(--Dark, #253340);
        text-align: center;
        font-size: 1.25rem;
        font-style: normal;
        font-weight: 600;
        line-height: normal;
        margin: 0;
        max-width: 16rem;
        width: 100%;
    }

    div.modal-content {
        padding: 2rem 1.5rem;
        width: 22.6875rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-bottom: 1rem;
    }

    div.modal-header {
        border-bottom: 0;
        padding: 0;
    }

    div.modal-body {
        padding: 0;
    }

    div.modal-footer {
        border-top: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
    }

    .modal__rating {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .modal__star {
        width: 2.5rem;
        height: 2.5rem;
        cursor: pointer;
        background-image: url("/assets/tickets/ratingModal/starEmpty.svg");
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
    }

    .modal__btn {
        width: 100%;
    }

    .modal__star_first {
        width: 50%;
        height: 100%;
    }

    .modal__star_second {
        width: 50%;
        height: 100%;
    }
</style>

<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <h4 class="modal__title" style="align-self: center">Спасибо за вашу оценку!</h4>
            <button type="button" class="modal__btn btn btn-primary" data-bs-dismiss="modal">ОК</button>
        </div>
    </div>
</div>
