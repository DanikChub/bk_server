<script src="~/lib/summernote/plugin/jquery/jquery-3.4.1.slim.min.js" asp-append-version="true"></script>
<script src="~/lib/summernote/summernote-lite.min.js" asp-append-version="true"></script>
<script src="~/js/global-scripts.js" asp-append-version="true"></script>

<script>
    $(document).ready(function () {
        new SummerNote('#summernote');

        const submitButton = document.querySelector(".chat-submit-button");
        const selector = ".note-editor.note-airframe .note-editing-area .note-editable, .note-editor.note-frame .note-editing-area .note-editable";
        const summerNoteTextErea = document.querySelector("#tickets-details-input");
        const textData = document.querySelector(`${selector} p`);
        const textField = document.querySelector(selector);

        submitButton.addEventListener("click", () => {
            if (!textData?.textContent?.length) {
                summerNoteTextErea.style.border = "1px solid red";
                textField.style.border = "1px solid red";
            }
        });

        const observer = new MutationObserver(() => {
            textField.style.border = "0px solid white";
        });

        observer.observe(textData, {
            childList: true,
            subtree: true,
            characterDataOldValue: false
        });
    });
</script>

<script>
    function validateFileSize(input) {
        var totalSize = 0;
        var files = input.files;

        for (var i = 0; i < files.length; i++) {
            totalSize += files[i].size;
        }

        if (totalSize > 50 * 1024 * 1024) {
            abp.notify.error('Суммарный размер файлов превышает максимальный размер 50 МБ. Пожалуйста, выберите файлы с меньшим размером.');
            input.value = '';
        }
    }
   
     const fileArr = [];

    $("#images").change(function () {
        const total_file = this.files;

        if (!total_file.length) return;

        Array.from(total_file).forEach(file => {
            if (!fileArr.some(existingFile => existingFile.name === file.name)) {
                fileArr.push(file);
            }
        });

        drawFiles(fileArr);
        updateInputFiles();
    });

    function drawFiles(fileList) {
        const filesImgsContainer = $('#image_preview');
        filesImgsContainer.html("");

        fileArr.forEach(file => {
            const { name } = file;
            const extension = "." + name.split('.').pop();

            filesImgsContainer.append(`
                    <div onclick="removeFileFromSummerNote('${name}')" class="file-box-item">
                        <div data-toggle="tooltip" title="${name}" class="file-box-item__file-name">
                            ${name}
                        </div>
                        <div class="file-box-item__img">
                            <div class="${chatIcon(extension)}"></div>
                        </div>
                        <div class="file-box-item__close hideCloseButton">
                            <i class="fa fa-times" aria-hidden="true"></i>
                        </div>
                    </div>`);
        });
    }

    function updateInputFiles() {
        const dataTransfer = new DataTransfer();
        fileArr.forEach(file => dataTransfer.items.add(file));

        const inputFile = document.querySelector('#images');
        inputFile.files = dataTransfer.files;
    }

    window.removeFileFromSummerNote = function (filename) {
        const index = fileArr.findIndex(file => file.name === filename);
        if (index !== -1) {
            fileArr.splice(index, 1);
            drawFiles(fileArr);
            updateInputFiles();
        }
    };
</script>

<script>
    $(function () {
        var ticketId = $("#Ticket_Id").val();
        var ratingModal = new abp.ModalManager(abp.appPath + 'Tickets/RatingModal');
        var previewTicketPrint = new abp.ModalManager(abp.appPath + 'Tickets/PreviewTicketPrintModal');
        var ratingSuccessModal = new abp.ModalManager(abp.appPath + 'Tickets/RatingSuccessModal');

        $("#ratingModal").on("click", function () {
            ratingModal.open({ ticketId: ticketId });
        });

        $("#printModal").on("click", function () {
            previewTicketPrint.open({ ticketId: ticketId });
        });

        ratingModal.onResult(function () {
            ratingSuccessModal.open();
        });
    });
</script>